# System Settings
PROJECT_NAME="VendorGuard AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production_environment_with_strong_secret"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with SQLite fallback for local dev)
POSTGRES_USER="vendorguard"
POSTGRES_PASSWORD="vendorguard_secure_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="vendorguard_db"

DATABASE_URL="sqlite+aiosqlite:///./vendorguard.db"

# AI Provider Settings ("ollama" or "openai")
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3.2"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# OpenAI Settings (Optional fallback when AI_PROVIDER="openai")
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Continuous Monitoring & Crawler
CRAWLER_USER_AGENT="VendorGuardAI-SecurityBot/1.0 (+https://vendorguard.ai)"
CRAWLER_TIMEOUT_SECONDS=30
DEFAULT_MONITORING_FREQUENCY_HOURS=24
