# ==============================================================================
# VENDORGUARD AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# System Settings
PROJECT_NAME="VendorGuard AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="dev_secret_key_change_in_production_environment_with_strong_secret"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL with SQLite fallback for local dev)
POSTGRES_USER="vendorguard"
POSTGRES_PASSWORD="vendorguard_secure_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="vendorguard_db"

# Database Connection String
# For PostgreSQL: postgresql+asyncpg://vendorguard:vendorguard_secure_password@localhost:5432/vendorguard_db
# For SQLite Fallback (default for quick dev initialization): sqlite+aiosqlite:///./vendorguard.db
DATABASE_URL="sqlite+aiosqlite:///./vendorguard.db"

# AI & LLM Provider Settings
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# Continuous Monitoring & Crawler
CRAWLER_USER_AGENT="VendorGuardAI-SecurityBot/1.0 (+https://vendorguard.ai)"
CRAWLER_TIMEOUT_SECONDS=30
DEFAULT_MONITORING_FREQUENCY_HOURS=24
